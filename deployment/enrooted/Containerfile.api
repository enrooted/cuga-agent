# Build from the fork root. Both Python stages share the same interpreter ABI.
ARG BUILDER_IMAGE=registry.access.redhat.com/hi/python:3.12-builder
ARG RUNTIME_IMAGE=registry.access.redhat.com/hi/python:3.12
FROM ghcr.io/astral-sh/uv:0.12.5 AS uv
FROM ${BUILDER_IMAGE} AS build
USER 0
WORKDIR /app
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1
COPY pyproject.toml uv.lock README.md LICENSE NOTICE ./
# Install third-party dependencies before copying the frequently changing agent.
RUN uv sync --locked --python /usr/bin/python3.12 --no-install-project --no-dev \
    --extra observability --extra evolve --group evolve-image \
    --no-install-package stanza --no-install-package udtools --no-install-package udapi
COPY deployment/evolve-image-spacy-model.txt ./deployment/
RUN uv pip install --no-config --no-deps --require-hashes -r deployment/evolve-image-spacy-model.txt
COPY src/cuga/ ./src/cuga/
COPY src/scripts/ ./src/scripts/
# Editable install keeps package-relative YAML, prompts and assets together with the code.
RUN uv pip install --no-deps --editable .
ENV FASTEMBED_CACHE_PATH=/app/.cache/fastembed \
    DOCLING_ARTIFACTS_PATH=/app/.cache/docling HF_HOME=/app/.cache/huggingface \
    SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence-transformers TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken \
    EVOLVE_EMBEDDING_PROVIDER=fastembed EVOLVE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 \
    EVOLVE_PG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 EVOLVE_CONSISTENCY_EMBEDDING_MODEL_SMALL=BAAI/bge-small-en-v1.5 \
    LITELLM_LOCAL_MODEL_COST_MAP=True MODEL_PRELOAD_STRICT=1 PYTHONUNBUFFERED=1 HF_HUB_DISABLE_XET=1
RUN .venv/bin/python src/scripts/preload_models.py && chmod -R a+rX /app/.cache \
    && mkdir -p /runtime/data /runtime/app/.cuga && chown -R 1001:0 /runtime/data /runtime/app/.cuga

FROM ${RUNTIME_IMAGE}
WORKDIR /app
COPY --from=build /runtime/ /
COPY LICENSE NOTICE ./
COPY --from=build /app/.venv/ /app/.venv/
COPY --from=build /app/src/ /app/src/
COPY --from=build /app/.cache/ /app/.cache/
COPY scripts/container_services.py deployment/enrooted/start_api.py /app/scripts/
ENV PATH=/app/.venv/bin:/usr/bin \
    HOME=/tmp USER=cuga LOGNAME=cuga PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    CUGA_LOGGING_DIR=/tmp/cuga-logging CUGA_DBS_DIR=/data/dbs \
    DYNACONF_UI__ENABLED=false DYNACONF_SERVER_PORTS__DEMO=7860 \
    EVOLVE_HOOKS_CONFIG=/app/src/cuga/configurations/evolve/hooks.yaml \
    FASTEMBED_CACHE_PATH=/app/.cache/fastembed DOCLING_ARTIFACTS_PATH=/app/.cache/docling \
    HF_HOME=/app/.cache/huggingface SENTENCE_TRANSFORMERS_HOME=/app/.cache/sentence-transformers \
    TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken CUSTOM_TIKTOKEN_CACHE_DIR=/app/.cache/tiktoken \
    HF_HUB_OFFLINE=1 HF_DATASETS_OFFLINE=1 TRANSFORMERS_OFFLINE=1 LITELLM_LOCAL_MODEL_COST_MAP=True \
    EVOLVE_EMBEDDING_PROVIDER=fastembed EVOLVE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 \
    EVOLVE_PG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5 EVOLVE_CONSISTENCY_EMBEDDING_MODEL_SMALL=BAAI/bge-small-en-v1.5
# Match the existing demo volume owner, including volumes created by the UBI deployment.
USER 1001:0
RUN --network=none ["/app/.venv/bin/python", "/app/src/scripts/verify_airgap.py"]
EXPOSE 7860
ENTRYPOINT ["/app/.venv/bin/python", "/app/scripts/start_api.py"]
CMD ["--host", "127.0.0.1", "--cuga-workspace", "/data/workspace"]
